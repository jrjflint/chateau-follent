// Each Shopify section owns its state and listeners, including theme-editor reloads.
function mountWineProfile(root, { restoredAnswers, mountResultAction, privacyNotice, onRestart,
  restartLabel = 'Restart and clear my details', restartAnnouncement = 'Your entered details have been cleared.',
  readyAnnouncement = 'Your Wine Profile is ready. Your answers have not been saved or emailed.' } = {}) {
  const app = root.querySelector('[data-wp-app]');
  const status = root.querySelector('[data-wp-status]');
  if (!app || !status) return () => {};
  const controller = new AbortController();
  const options = { signal: controller.signal };
  const fresh = () => ({ view: 'welcome', question: 0, name: '', dob: { day: '', month: '', year: '' }, answers: {}, profile: null });
  let state = fresh();
  let restoring = Boolean(restoredAnswers);
  if (restoring) { state.answers = structuredClone(restoredAnswers); state.view = 'intro'; }
  let cleanResultAction;
  const notice = privacyNotice ?? '<p class="wp-note">Your entries stay in this page while you explore. This quiz does not save your answers or send email.</p>';
  const restart = `<button type="button" class="wp-text-button" data-action="restart">${e(restartLabel)}</button>`;
  const back = () => '<button type="button" class="wp-back" data-action="back">← Back</button>';
  const error = '<p class="wp-error" role="alert" data-wp-error></p>';
  const privacy = root.dataset.privacyUrl || '/policies/privacy-policy';
  const journal = root.dataset.journalUrl || '/pages/vintages';

  function announce(text) { status.textContent = text; }
  function showError(text, target) {
    app.querySelector('[data-wp-error]').textContent = text;
    if (target) { target.setAttribute('aria-invalid', 'true'); target.focus(); }
  }
  function clearError() {
    const target = app.querySelector('[data-wp-error]');
    if (target) target.textContent = '';
    app.querySelectorAll('[aria-invalid]').forEach((input) => input.removeAttribute('aria-invalid'));
  }
  function intro() {
    return `${restoring ? '<p role="status">Your answer choices have been restored. Enter your name and complete adult screening again to return to your results.</p>' : ''}<section aria-labelledby="intro-title"><p class="wp-eyebrow">Before we begin</p><h2 id="intro-title" tabindex="-1" data-step-heading>A proper introduction.</h2><p>What should we call you? First, a little information to keep this an adults-only experience.</p><form data-form="intro" novalidate><label class="wp-label" for="wp-first-name">First name</label><input id="wp-first-name" name="first_name" autocomplete="given-name" maxlength="80" required value="${e(state.name)}"><fieldset class="wp-dob"><legend>Date of birth</legend><div class="wp-date-fields">${[['day', 'Day', 'DD', 2], ['month', 'Month', 'MM', 2], ['year', 'Year', 'YYYY', 4]].map(([key, label, placeholder, length]) => `<div><label for="wp-${key}">${label}</label><input id="wp-${key}" name="${key}" type="text" inputmode="numeric" autocomplete="bday-${key}" maxlength="${length}" placeholder="${placeholder}" required value="${e(state.dob[key])}" aria-describedby="wp-dob-note"></div>`).join('')}</div></fieldset><p class="wp-note" id="wp-dob-note">You must be 18 or older to continue. Your date of birth is used only for adult screening in this page and is not saved. This is self-declared screening, not independent age or identity verification.</p>${notice}<p class="wp-note"><a href="${e(privacy)}" target="_blank" rel="noopener noreferrer">Privacy Policy (opens in a new tab)</a></p>${error}<div class="wp-actions">${back()}<button class="wp-primary" type="submit">Begin my profile →</button></div></form></section>`;
  }
  function question() {
    const q = QUESTIONS[state.question];
    const selected = state.answers[q.id];
    const hint = q.kind === 'single' ? 'Choose one answer.' : q.max ? 'Choose up to three. “I’m not sure yet” is an answer on its own.' : q.exclusive === 'non_drinker' ? 'Choose all that apply. Not drinking or purchasing wine is an answer on its own.' : 'Choose all that apply. “I’m still exploring” is an answer on its own.';
    return `<section aria-labelledby="question-title"><div class="wp-progress-copy"><p class="wp-eyebrow">Question ${state.question + 1} of ${QUESTIONS.length}</p><span>${Math.round((state.question + 1) / QUESTIONS.length * 100)}%</span></div><progress class="wp-progress" value="${state.question + 1}" max="${QUESTIONS.length}" aria-label="Question progress"></progress><h2 id="question-title" tabindex="-1" data-step-heading>${e(q.title)}</h2><p class="wp-note" id="question-help">${hint}</p><form data-form="question" novalidate><fieldset class="wp-options" aria-describedby="question-help"><legend class="sr-only">${e(q.title)}</legend>${q.options.map((item) => `<label class="wp-option"><input type="${q.kind === 'single' ? 'radio' : 'checkbox'}" name="answer" value="${e(item.id)}" ${Array.isArray(selected) ? selected.includes(item.id) ? 'checked' : '' : selected === item.id ? 'checked' : ''}><span>${e(item.label)}</span></label>`).join('')}</fieldset>${q.max ? `<p class="wp-note wp-selection-count" data-wp-count>${Array.isArray(selected) ? selected.length : 0} of 3 selected</p>` : ''}${error}<div class="wp-actions">${back()}<button class="wp-primary" type="submit">${state.question === QUESTIONS.length - 1 ? 'Discover my profile' : 'Continue'} →</button></div></form></section>`;
  }
  function result() {
    const profile = { ...state.profile, journal: { ...state.profile.journal, href: journal } };
    return `${profileMarkup(profile)}<div class="wp-result-actions"><button class="wp-primary" type="button" data-action="print">Print / save my profile</button><button class="wp-back" type="button" data-action="edit">Edit my answers</button></div>${mountResultAction ? '<div data-wp-result-action></div>' : ''}${notice}`;
  }
  function render(focus = true) {
    cleanResultAction?.(); cleanResultAction = null;
    root.dataset.phase = state.view;
    status.textContent = '';
    app.innerHTML = (state.view === 'welcome' ? `<section class="wp-welcome"><p class="wp-kicker" tabindex="-1" data-step-heading>Every palate has a story.<br><em>Discover yours.</em></p><p class="wp-lede">Answer seven simple questions to discover your personalised Chateau Follent Wine Profile, including wine styles to explore, tasting suggestions and insights from the winery.</p><div class="wp-facts"><span>About two minutes</span><span>Seven simple questions</span><span>For adults 18+</span></div><button class="wp-primary" type="button" data-action="start">Discover My Wine Profile →</button><p class="wp-note">Free to explore. No purchase, account or subscription required.</p>${notice}</section>` : state.view === 'intro' ? intro() : state.view === 'question' ? question() : result()) + (state.view === 'welcome' ? '' : `<div class="wp-clear-row">${restart}</div>`);
    if (state.view === 'result' && mountResultAction) cleanResultAction = mountResultAction(app.querySelector('[data-wp-result-action]'), structuredClone(state.answers));
    if (focus) {
      const heading = app.querySelector('[data-step-heading], #profile-title');
      heading?.focus({ preventScroll: true });
      heading?.scrollIntoView({ block: 'start', behavior: 'auto' });
    }
  }
  function readIdentity(form) {
    const fields = new FormData(form);
    state.name = String(fields.get('first_name') ?? '').trim();
    state.dob = Object.fromEntries(['day', 'month', 'year'].map((key) => [key, String(fields.get(key) ?? '').trim()]));
  }
  root.addEventListener('input', (event) => {
    if (event.target.closest('[data-form="intro"]')) readIdentity(event.target.form);
    clearError();
  }, options);
  root.addEventListener('change', (event) => {
    if (!event.target.matches('input[name="answer"]')) return;
    const q = QUESTIONS[state.question];
    const next = updateSelection(q, state.answers[q.id], event.target.value, event.target.checked);
    state.answers[q.id] = next.value;
    state.profile = null;
    app.querySelectorAll('input[name="answer"]').forEach((input) => { input.checked = Array.isArray(next.value) ? next.value.includes(input.value) : next.value === input.value; });
    if (q.max) { app.querySelector('[data-wp-count]').textContent = `${next.value.length} of 3 selected`; announce(`${next.value.length} of 3 selected`); }
    if (next.error) showError(next.error); else clearError();
  }, options);
  root.addEventListener('submit', (event) => {
    const form = event.target;
    if (!form.matches('[data-form]')) return;
    event.preventDefault();
    clearError();
    if (form.dataset.form === 'intro') {
      readIdentity(form);
      if (!state.name || state.name.length > 80) return showError('Enter your first name (up to 80 characters).', form.elements.first_name);
      if (!/^\d{1,2}$/.test(state.dob.day) || !/^\d{1,2}$/.test(state.dob.month) || !/^\d{4}$/.test(state.dob.year)) return showError('Enter your complete date of birth as day, month and four-digit year.', form.elements.day);
      const age = screenAge(`${state.dob.year}-${state.dob.month.padStart(2, '0')}-${state.dob.day.padStart(2, '0')}`);
      if (!age.eligible) return showError(age.error, form.elements.day);
      if (restoring) { state.profile = generateProfile(state.answers); state.view = 'result'; restoring = false; }
      else { state.question = 0; state.view = 'question'; }
    } else {
      const q = QUESTIONS[state.question];
      const message = validateAnswer(q, state.answers[q.id]);
      if (message) return showError(message, form.querySelector('input'));
      if (state.question === QUESTIONS.length - 1) { state.profile = generateProfile(state.answers); state.view = 'result'; }
      else state.question += 1;
    }
    render();
    if (state.view === 'result') announce(readyAnnouncement);
  }, options);
  root.addEventListener('click', (event) => {
    const action = event.target.closest('[data-action]')?.dataset.action;
    if (!action) return;
    if (action === 'print') return window.print();
    if (action === 'restart') { onRestart?.(); state = fresh(); restoring = false; render(); announce(restartAnnouncement); return; }
    if (action === 'start') state.view = 'intro';
    if (action === 'edit') { state.view = 'question'; state.question = 0; state.profile = null; }
    if (action === 'back') {
      if (state.view === 'intro') state.view = 'welcome';
      else if (state.question > 0) state.question -= 1;
      else state.view = 'intro';
    }
    render();
  }, options);
  window.addEventListener('pagehide', () => { cleanResultAction?.(); cleanResultAction = null; restoring = false; state = fresh(); app.replaceChildren(); status.textContent = ''; }, options);
  window.addEventListener('pageshow', (event) => { if (event.persisted) render(false); }, options);
  render(false);
  return () => { controller.abort(); cleanResultAction?.(); state = fresh(); app.replaceChildren(); status.textContent = ''; };
}

if (typeof customElements !== 'undefined' && !customElements.get('cf-wine-profile')) {
  customElements.define('cf-wine-profile', class extends HTMLElement {
    connectedCallback() { this.cleanup ??= mountWineProfile(this); }
    disconnectedCallback() { this.cleanup?.(); this.cleanup = null; }
  });
}


// Temporary answer-only sign-in handoff for Lord James Follent; not used by Stage 1.
const KEY = 'cf-wine-profile-login-v1';
const TTL = 20 * 60 * 1000;
function answerIds(answers) {
  validateAnswers(answers);
  return Object.fromEntries(QUESTIONS.map((question) => [question.id, question.kind === 'multi'
    ? question.options.filter((option) => answers[question.id].includes(option.id)).map((option) => option.id)
    : answers[question.id]]));
}
function rememberForLogin(storage, answers, now = Date.now()) {
  storage.setItem(KEY, JSON.stringify({ version: QUIZ_VERSION, expiresAt: now + TTL, answers: answerIds(answers) }));
}
function clearLoginHandoff(storage) { storage.removeItem(KEY); }
function restoreAfterLogin(storage, now = Date.now()) {
  const raw = storage.getItem(KEY);
  clearLoginHandoff(storage);
  if (!raw || raw.length > 4096) return null;
  try {
    const value = JSON.parse(raw);
    if (value.version !== QUIZ_VERSION || !Number.isFinite(value.expiresAt) || value.expiresAt <= now || value.expiresAt > now + TTL) return null;
    return { answers: answerIds(value.answers), adultScreenRequired: true };
  } catch { return null; }
}


const statuses = new Set(['email_requested', 'needs_subscription', 'preparing', 'dispatching', 'review', 'failed', 'skipped']);
class EmailRequestError extends Error {
  constructor(code) { super(code); this.code = code; }
}

// Optional Stage 2 client for Lord James Follent; Stage 1 does not import or mount it.
function createEmailSession({ answers, adultConfirmed, fetcher = fetch, randomId = () => crypto.randomUUID(), basePath = '/apps/wine-profile' }) {
  if (!/^\/apps\/[a-z0-9-]+$/.test(basePath)) throw new EmailRequestError('invalid_proxy_path');
  const safeAnswers = answerIds(answers);
  const submissionId = randomId();
  let pending;
  async function call(path, options = {}) {
    let response, value;
    try {
      response = await fetcher(basePath + path, { credentials: 'same-origin', cache: 'no-store', ...options, signal: AbortSignal.timeout(20000) });
      value = await response.json();
    } catch { throw new EmailRequestError('request_not_confirmed'); }
    if (!response.ok && !statuses.has(value?.status)) throw new EmailRequestError(value?.error ?? 'request_not_confirmed');
    return value;
  }
  function checkedStatus(value) {
    if (!statuses.has(value?.status) || value.submissionId !== submissionId) throw new EmailRequestError('invalid_request_status');
    return value;
  }
  return {
    submissionId,
    context: () => call('/context'),
    rememberForSignIn(storage) { rememberForLogin(storage, safeAnswers); },
    requestEmail() {
      if (pending) return pending;
      pending = (async () => {
        if (adultConfirmed !== true) throw new EmailRequestError('adult_screen_required');
        const context = await call('/context');
        if (context.emailRequestsAvailable !== true) throw new EmailRequestError('email_requests_disabled');
        if (context.signedIn !== true) return { status: 'sign_in_required', submissionId };
        if (context.subscriptionState !== 'SUBSCRIBED') return { status: 'needs_subscription', submissionId, subscriptionState: context.subscriptionState };
        if (typeof context.csrfToken !== 'string' || !context.csrfToken) throw new EmailRequestError('invalid_csrf');
        return checkedStatus(await call('/request', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
          quizVersion: QUIZ_VERSION, submissionId, answers: safeAnswers, adultConfirmed: true, csrfToken: context.csrfToken,
        }) }));
      })().finally(() => { pending = null; });
      return pending;
    },
    async checkStatus() { return checkedStatus(await call('/status?submission_id=' + encodeURIComponent(submissionId))); },
  };
}


const messages = {
  email_requests_disabled: 'Email requests are not available yet. Your complete profile is still here to read or print.',
  profile_request_processing: 'An earlier profile request is still processing. Please wait before requesting a changed profile.',
  customer_tag_capacity: 'Your profile could not be prepared for email. Please contact Chateau Follent for help.',
  adult_screen_required: 'Please complete the adult screening again before requesting an email.',
  submission_not_found: 'No accepted request was found for this attempt. You can retry with the same request reference.',
};

// Optional results controls for Lord James Follent. No request runs before an explicit action.
function mountEmailPanel(host, { answers, adultConfirmed, signupForm, loginUrl, storage = () => window.sessionStorage,
  navigate = (url) => window.location.assign(url), session = createEmailSession({ answers, adultConfirmed }) }) {
  const listeners = new AbortController();
  let alive = true, pending = false, mode = 'idle', message = '';
  const originalParent = signupForm?.parentNode;
  const originalNext = signupForm?.nextSibling;
  function parkForm() {
    if (!signupForm || !originalParent) return;
    signupForm.hidden = true;
    const consent = signupForm.querySelector('[data-wp-signup-consent]');
    if (consent) consent.checked = false;
    originalParent.insertBefore(signupForm, originalNext?.parentNode === originalParent ? originalNext : null);
  }
  function button(action, text, primary = false) {
    const item = host.ownerDocument.createElement('button');
    item.type = 'button'; item.dataset.emailAction = action;
    item.className = primary ? 'wp-primary' : 'wp-back'; item.textContent = text; item.disabled = pending;
    return item;
  }
  function render() {
    if (!alive) return;
    parkForm();
    host.replaceChildren(); host.className = 'wp-section wp-email-panel';
    const title = host.ownerDocument.createElement('h3'); title.textContent = 'Keep your Wine Profile'; host.append(title);
    const description = host.ownerDocument.createElement('p');
    description.textContent = 'Optional: save this profile to your customer account and request an email with your full results. Sign-in and a confirmed email-marketing subscription are required. You can keep reading or printing without either.';
    host.append(description);
    const status = host.ownerDocument.createElement('p'); status.setAttribute('role', 'status'); status.setAttribute('aria-live', 'polite');
    status.tabIndex = -1;
    status.textContent = pending ? 'Checking your request…' : message; host.append(status);
    const actions = host.ownerDocument.createElement('div'); actions.className = 'wp-actions';
    if (mode === 'idle' || mode === 'failed') actions.append(button('request', mode === 'failed' ? 'Retry email request' : 'Email my profile', true));
    if (mode === 'signin') actions.append(button('signin', 'Sign in to email my profile', true));
    if (mode === 'subscribe') {
      if (signupForm) { signupForm.hidden = false; host.append(signupForm); }
      else {
        const note = host.ownerDocument.createElement('p'); note.textContent = 'Please sign in again to load the subscription form.'; host.append(note);
        actions.append(button('signin', 'Sign in again'));
      }
      actions.append(button('subscription', 'Check my subscription'));
    }
    if (mode === 'confirmation') actions.append(button('subscription', 'Check my subscription'));
    if (mode === 'accepted' || mode === 'review' || mode === 'unknown') actions.append(button('status', 'Check request status'));
    if (!['accepted', 'review', 'declined'].includes(mode)) actions.append(button('decline', 'Keep my on-page results'));
    host.append(actions); host.setAttribute('aria-busy', String(pending));
  }
  function showResult(result) {
    switch (result.status) {
      case 'email_requested': mode = 'accepted'; message = 'Email requested. Delivery has not been confirmed.'; break;
      case 'sign_in_required': mode = 'signin'; message = 'Sign in to save and email your results. Only your answer choices will be kept temporarily for your return; enter your name and complete adult screening again.'; break;
      case 'needs_subscription':
        mode = result.subscriptionState === 'PENDING' ? 'confirmation' : 'subscribe';
        message = mode === 'confirmation' ? 'Your subscription is awaiting confirmation. Check your inbox, then check your subscription here. No profile email has been requested.' : 'Subscribe only if you would like email marketing from Chateau Follent. The signup option is separate and unchecked. No profile email has been requested.';
        break;
      case 'failed': mode = 'failed'; message = 'Your profile could not be prepared for email. You can retry this request.'; break;
      case 'skipped': mode = 'skipped'; message = 'The email request was skipped. Your results remain here. After checking your subscription, you can edit your answers and make a new request.'; break;
      case 'review': mode = 'review'; message = 'We could not confirm the outcome of your request. It has been held for review to avoid duplicate emails.'; break;
      default: mode = 'unknown'; message = 'Your request is still processing. You can check its status.';
    }
  }
  async function perform(operation) {
    if (pending || !alive) return;
    pending = true; render();
    try { const result = await operation(); if (alive && result) showResult(result); }
    catch (error) {
      if (!alive) return;
      mode = error.code === 'email_requests_disabled' ? 'disabled' : error.code === 'submission_not_found' ? 'failed' : error.code === 'sign_in_required' ? 'signin' : 'unknown';
      message = messages[error.code] ?? 'We could not confirm this request. Check its status before trying again; it may already have been accepted.';
    } finally { pending = false; render(); if (alive) host.querySelector('[role="status"]')?.focus({ preventScroll: true }); }
  }
  async function checkSubscription() {
    const context = await session.context();
    if (!context.emailRequestsAvailable) throw new EmailRequestError('email_requests_disabled');
    if (!context.signedIn) return { status: 'sign_in_required' };
    if (context.subscriptionState !== 'SUBSCRIBED') return { status: 'needs_subscription', subscriptionState: context.subscriptionState };
    mode = 'idle'; message = 'Your subscription is confirmed. Choose “Email my profile” to request your results.';
  }
  host.addEventListener('click', (event) => {
    const action = event.target.closest('[data-email-action]')?.dataset.emailAction;
    if (!action || pending) return;
    if (action === 'decline') { mode = 'declined'; message = 'Your results remain available on this page. No new email request has been made.'; render(); return; }
    if (action === 'request') return perform(() => session.requestEmail());
    if (action === 'status') return perform(() => session.checkStatus());
    if (action === 'subscription') return perform(checkSubscription);
    if (action === 'signin') {
      try {
        const url = new URL(loginUrl, window.location.origin);
        if (url.origin !== window.location.origin || !/^\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?(?:account\/login|customer_authentication\/login)$/i.test(url.pathname)) throw new Error('Invalid sign-in route');
        session.rememberForSignIn(storage());
        navigate(url.href);
      } catch { message = 'Your browser could not prepare sign-in. Your results remain here; allow temporary session storage and try again.'; render(); }
    }
  }, { signal: listeners.signal });
  signupForm?.addEventListener('submit', (event) => {
    if (!signupForm.querySelector('[data-wp-signup-consent]')?.checked || pending) { event.preventDefault(); return; }
    try { session.rememberForSignIn(storage()); }
    catch { event.preventDefault(); message = 'Your browser could not keep your answer choices for the signup return. Your results remain here; allow temporary session storage and try again.'; render(); }
  }, { signal: listeners.signal });
  render();
  return () => { alive = false; listeners.abort(); parkForm(); host.replaceChildren(); };
}


// Separate Stage 2 entry for Lord James Follent; generated disabled and never loaded by Stage 1.
function mountEmailWineProfile(root, { sessionFor, navigate, storage = () => window.sessionStorage } = {}) {
  if (root.dataset.emailEnabled !== 'true') return mountWineProfile(root);
  let restored;
  try { restored = restoreAfterLogin(storage()); } catch { /* Storage can be disabled without affecting the quiz. */ }
  const signupForm = root.querySelector('[data-wp-native-signup]');
  return mountWineProfile(root, {
    restoredAnswers: restored?.answers,
    readyAnnouncement: 'Your Wine Profile is ready. Saving and emailing it is optional.',
    restartLabel: 'Restart this quiz',
    restartAnnouncement: 'Your entries on this page have been cleared. A profile already saved to your account remains saved.',
    onRestart: () => { try { clearLoginHandoff(storage()); } catch { /* The quiz still resets when storage is unavailable. */ } },
    privacyNotice: '<p class="wp-note">Your quiz entries stay in this page unless you choose to save and email your profile. That option requires sign-in and a confirmed marketing subscription. Only answer choices are kept temporarily when you choose sign-in or signup; your name and date of birth are excluded.</p>',
    mountResultAction: (host, answers) => mountEmailPanel(host, {
      answers, adultConfirmed: true, signupForm, loginUrl: root.dataset.loginUrl, storage,
      ...(navigate ? { navigate } : {}),
      ...(sessionFor ? { session: sessionFor(answers) } : {}),
    }),
  });
}

if (typeof customElements !== 'undefined' && !customElements.get('cf-wine-profile-email')) {
  customElements.define('cf-wine-profile-email', class extends HTMLElement {
    connectedCallback() { this.cleanup ??= mountEmailWineProfile(this); }
    disconnectedCallback() { this.cleanup?.(); this.cleanup = null; }
  });
}

})();</script>

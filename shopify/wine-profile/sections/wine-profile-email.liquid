{% comment %}Wine Profile section for Lord James Follent: Stage 2 setup artifact; email controls disabled pending integration and release checks. Do not install as a working email service. Self-contained custom element with abortable listeners. Generated from source modules with node tools/build-wine-profile-shopify.mjs --with-email.{% endcomment %}
{% stylesheet %}/* Isolated additions to the established Chateau Follent brand system. */
.cf-wine-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  padding: 1.25rem 1rem 2.5rem;
  background: var(--color-background, #f2f0ea);
}
.cf-wine-profile *, .cf-wine-profile *::before, .cf-wine-profile *::after { box-sizing: border-box; }
.cf-wine-profile .site-header, .cf-wine-profile .wp-shell, .cf-wine-profile .site-footer { width: min(100%, 50rem); }
.cf-wine-profile .site-header { margin: .25rem 0 1.25rem; }
.cf-wine-profile .brand-lockup { text-decoration: none; gap: .45rem; margin: 0 auto; }
.cf-wine-profile .brand-wordmark { font: 700 1.4rem/1.1 'Libre Baskerville', Georgia, serif; letter-spacing: .08em; color: var(--color-text); margin: 0; }
.cf-wine-profile .brand-crest { width: 6.75rem; }
.cf-wine-profile .wp-shell { padding: clamp(1.25rem, 5vw, 3.25rem); border-radius: .4rem; box-shadow: 0 12px 40px rgba(10,10,12,.035); }
.cf-wine-profile .wp-masthead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem; padding-bottom: 1rem; margin-bottom: 1.8rem; border-bottom: 1px solid var(--wp-border); }
.cf-wine-profile .wp-eyebrow, .cf-wine-profile .wp-edition { font-size: .66rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; line-height: 1.6; }
.cf-wine-profile .wp-eyebrow { color: var(--color-accent); margin: 0 0 .65rem; }
.cf-wine-profile .wp-masthead .wp-eyebrow { margin: 0; }
.cf-wine-profile .wp-edition { color: var(--color-muted); letter-spacing: .04em; }
.cf-wine-profile h1 { font-size: clamp(2rem, 5.4vw, 3rem); line-height: 1.2; margin-bottom: 1.5rem; letter-spacing: -.025em; }
.cf-wine-profile h2 { font-size: clamp(1.5rem, 4.5vw, 2.15rem); line-height: 1.4; letter-spacing: -.02em; margin: .9rem 0 1.1rem; }
.cf-wine-profile h3 { font-size: clamp(1.25rem, 3vw, 1.6rem); line-height: 1.45; margin-bottom: .85rem; }
.cf-wine-profile h4 { font-size: 1.12rem; line-height: 1.5; margin: 0 0 .65rem; }
.cf-wine-profile p, .cf-wine-profile li { font-size: 1rem; line-height: 1.75; }
.cf-wine-profile p { margin-bottom: 1.1rem; }
.cf-wine-profile .wp-kicker { font: 400 clamp(1.5rem, 4vw, 2rem)/1.5 'Libre Baskerville', Georgia, serif; color: var(--color-text); margin: 1.75rem 0 1.25rem; }
.cf-wine-profile .wp-kicker em { color: var(--color-accent); }
.cf-wine-profile .wp-lede { max-width: 53ch; }
.cf-wine-profile .wp-facts { display: flex; flex-wrap: wrap; gap: .4rem 1rem; padding: .4rem 0 1.5rem; color: var(--color-muted); font-size: .78rem; }
.cf-wine-profile .wp-facts span + span::before { content: '·'; margin-right: .7rem; }
.cf-wine-profile .wp-primary { display: inline-flex; align-items: center; justify-content: center; gap: .8rem; min-height: 3.3rem; padding: .9rem 1.25rem; border-radius: .2rem; font-size: .9rem; letter-spacing: .015em; line-height: 1.5; box-shadow: none; }
.cf-wine-profile button:disabled { cursor: wait; opacity: .65; }
.cf-wine-profile .wp-welcome > .wp-primary { margin-bottom: 1rem; width: 100%; }
.cf-wine-profile .wp-note { font-size: .82rem; line-height: 1.7; color: #535962; }
.cf-wine-profile .wp-welcome-bottom { display: flex; align-items: center; gap: 1.5rem; margin: 2rem 0 1.5rem; }
.cf-wine-profile .wp-welcome-bottom p { font: 400 .87rem/1.7 'Libre Baskerville', Georgia, serif; margin: 0; color: var(--color-muted); }
.cf-wine-profile .wp-line { width: 2.5rem; height: 1px; background: var(--color-accent); }
.cf-wine-profile .wp-prototype { padding: 1rem; border-left: 2px solid var(--color-accent); background: var(--color-accent-soft); font-size: .78rem; line-height: 1.75; margin: 1.25rem 0; color: #42424b; }
.cf-wine-profile .wp-prototype strong { color: var(--color-accent); }
.cf-wine-profile .wp-label, .cf-wine-profile legend { display: block; font-size: .9rem; font-weight: 600; color: var(--color-text); margin: 1.25rem 0 .6rem; }
.cf-wine-profile input:not([type='radio']):not([type='checkbox']), .cf-wine-profile select { width: 100%; min-width: 0; min-height: 3.15rem; border: 1px solid #8a847a; background: var(--color-surface); color: var(--color-text); border-radius: .2rem; padding: .8rem; font: inherit; font-size: 1rem; }
.cf-wine-profile input::placeholder { color: #62626c; }
.cf-wine-profile select { text-overflow: ellipsis; padding-right: 1.25rem; }
.cf-wine-profile fieldset { padding: 0; border: 0; min-width: 0; margin: 0; }
.cf-wine-profile .wp-date-fields { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: .75rem; margin-bottom: 1rem; max-width: 27rem; }
.cf-wine-profile .wp-date-fields label { display: block; font-size: .8rem; color: var(--color-muted); margin-bottom: .4rem; }
.cf-wine-profile .wp-actions { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-top: 1.5rem; padding-top: .9rem; border-top: 1px solid var(--wp-border); }
.cf-wine-profile .wp-actions .wp-primary { flex: 0 1 auto; }
.cf-wine-profile .wp-back { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 3rem; border-radius: .2rem; border: 1px solid transparent; padding: .7rem .4rem; font-size: .86rem; background: transparent; white-space: nowrap; }
.cf-wine-profile .wp-back:hover { background: var(--color-accent-soft); }
.cf-wine-profile .wp-error { color: #8a1133; font-size: .87rem; font-weight: 600; margin: 1rem 0; }
.cf-wine-profile .wp-error:empty { margin: 0; }
.cf-wine-profile [aria-invalid='true'] { border-color: #8a1133!important; }
.cf-wine-profile .wp-progress-copy { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; font-size: .75rem; color: var(--color-muted); }
.cf-wine-profile .wp-progress-copy p { margin: 0; }
.cf-wine-profile .wp-progress { display: block; appearance: none; border: 0; border-radius: 0; width: 100%; height: 3px; margin: .6rem 0 1.8rem; background: var(--wp-border); color: var(--color-accent); }
.cf-wine-profile .wp-progress::-webkit-progress-bar { background: var(--wp-border); }
.cf-wine-profile .wp-progress::-webkit-progress-value { background: var(--color-accent); }
.cf-wine-profile .wp-progress::-moz-progress-bar { background: var(--color-accent); }
.cf-wine-profile .wp-options { display: grid; gap: .65rem; margin-top: 1.25rem; }
.cf-wine-profile .wp-option { display: flex; align-items: center; gap: .9rem; min-height: 3.5rem; border: 1px solid var(--wp-border); border-radius: .25rem; padding: .85rem 1rem; font-size: .9rem; line-height: 1.65; cursor: pointer; transition: background-color 120ms ease, border-color 120ms ease; }
.cf-wine-profile input[type='checkbox'], .cf-wine-profile input[type='radio'] { flex: 0 0 1.2rem; width: 1.2rem; height: 1.2rem; margin: 0; accent-color: var(--color-accent); cursor: pointer; }
.cf-wine-profile .wp-option:has(input:checked) { background: var(--color-accent-soft); border-color: var(--color-accent); }
.cf-wine-profile .wp-option:hover { border-color: var(--color-accent); }
.cf-wine-profile .wp-option:has(input:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 3px; }
.cf-wine-profile .wp-selection-count { margin: .75rem 0 0; }
.cf-wine-profile .wp-clear-row { border-top: 1px solid var(--wp-border); padding-top: 1rem; margin-top: 1.5rem; }
.cf-wine-profile .wp-text-button { min-height: 2.75rem; padding: .4rem 0; font-size: .76rem; text-decoration: underline; text-underline-offset: .25em; border: 0; border-radius: 0; background: none; color: var(--color-muted); }
.cf-wine-profile .wp-result-teaser { border: 1px solid var(--wp-border); padding: 1.25rem; margin: 1.5rem 0; background: linear-gradient(130deg, var(--color-accent-soft), transparent); }
.cf-wine-profile .wp-result-teaser p:last-child { margin: 0; }
.cf-wine-profile .wp-optional { font-weight: 400; color: var(--color-muted); font-size: .75rem; display: inline-block; margin-left: .3rem; }
.cf-wine-profile .wp-consents { margin: .75rem 0 1rem; }
.cf-wine-profile .wp-check { display: flex; align-items: flex-start; gap: .85rem; font-size: .82rem; line-height: 1.8; cursor: pointer; margin-bottom: .8rem; padding: .6rem 0; }
.cf-wine-profile .wp-check input { margin-top: .2rem; }
.cf-wine-profile .wp-submit-note { margin-top: .75rem; }
.cf-wine-profile .wp-section { border-top: 1px solid var(--wp-border); margin-top: 2rem; padding-top: 1.75rem; }
.cf-wine-profile .wp-preferences { margin: 0; }
.cf-wine-profile .wp-preferences div { padding: .8rem 0; border-bottom: 1px solid var(--wp-border); }
.cf-wine-profile dt { font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--color-accent); margin-bottom: .4rem; }
.cf-wine-profile dd { margin: 0; font-size: .9rem; line-height: 1.7; }
.cf-wine-profile .wp-recommendations { list-style: none; margin: 1.5rem 0 0; padding: 0; }
.cf-wine-profile .wp-recommendations li { display: flex; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--wp-border); }
.cf-wine-profile .wp-number { color: var(--color-accent); font: 400 1.2rem/1.5 'Libre Baskerville', Georgia, serif; padding-top: .1rem; }
.cf-wine-profile .wp-recommendations p { font-size: .9rem; margin-bottom: .65rem; }
.cf-wine-profile .wp-recommendations p:last-child { margin-bottom: 0; }
.cf-wine-profile .wp-sensory { border-left: 2px solid var(--wp-border); padding-left: .8rem; }
.cf-wine-profile .wp-sensory strong { color: var(--color-accent); display: block; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }
.cf-wine-profile .wp-exercise { background: var(--color-accent-soft); padding: 1.5rem; border-top: 2px solid var(--color-accent); }
.cf-wine-profile .wp-exercise p:last-child { margin-bottom: 0; }
.cf-wine-profile .wp-result-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
.cf-wine-profile details { margin-top: 1rem; }
.cf-wine-profile summary { cursor: pointer; font-weight: 600; font-size: .9rem; padding: 1rem .75rem; border: 1px solid var(--wp-border); border-radius: .2rem; color: var(--color-accent); }
.cf-wine-profile iframe { display: block; width: 100%; height: 48rem; border: 1px solid var(--wp-border); margin-top: .75rem; background: var(--color-background, #f2f0ea); }
.cf-wine-profile .site-footer { padding: 1.4rem 0 0; border: 0; background: none; box-shadow: none; border-radius: 0; margin-top: .75rem; }
.cf-wine-profile .footer-heading { font-size: .9rem; }
.cf-wine-profile .footer-nav-links { gap: .6rem 1.4rem; }
.cf-wine-profile .footer-nav-links a { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: .8rem; }
.cf-wine-profile .footer-note { font-size: .7rem; margin: 0; }
.cf-wine-profile :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
.cf-wine-profile [data-step-heading]:focus, .cf-wine-profile #profile-title:focus { outline: none; }
.cf-wine-profile [data-step-heading], .cf-wine-profile #profile-title { scroll-margin-top: 1.5rem; }
.cf-wine-profile .wp-skip { position: absolute; left: 1rem; top: -10rem; background: var(--color-surface); z-index: 10; padding: .75rem; }
.cf-wine-profile .wp-skip:focus { top: .5rem; }
.cf-wine-profile:not([data-phase='welcome']) .wp-page-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.cf-wine-profile:not([data-phase='welcome']) .site-header { margin-bottom: .9rem; }
.cf-wine-profile:not([data-phase='welcome']) .brand-wordmark { font-size: 1rem; }
.cf-wine-profile:not([data-phase='welcome']) .brand-crest { width: 4.85rem; }
@media (min-width: 640px) {
  .cf-wine-profile { padding-top: 2rem; }
  .cf-wine-profile .wp-welcome > .wp-primary { width: auto; }
  .cf-wine-profile .wp-preferences { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
}
@media (max-width: 420px) {
  .cf-wine-profile { padding: 1rem .75rem 2rem; }
  .cf-wine-profile .wp-shell { padding: 1.2rem; }
  .cf-wine-profile .wp-edition { display: none; }
  .cf-wine-profile .wp-actions { gap: .4rem; }
  .cf-wine-profile .wp-actions .wp-primary { padding-inline: .75rem; font-size: .8rem; }
  .cf-wine-profile .wp-back { font-size: .78rem; }
  .cf-wine-profile .wp-option { padding: .8rem .75rem; }
  .cf-wine-profile .wp-facts { gap: .5rem; }
  .cf-wine-profile .wp-facts span + span::before { margin-right: .4rem; }
}
@media (prefers-reduced-motion: reduce) {
  .cf-wine-profile *, .cf-wine-profile *::before, .cf-wine-profile *::after { transition: none!important; scroll-behavior: auto!important; }
}
@media print {
  .cf-wine-profile { display: block; background: white; padding: 0; }
  .cf-wine-profile .site-header, .cf-wine-profile .site-footer, .cf-wine-profile .wp-masthead, .cf-wine-profile .wp-page-title, .cf-wine-profile .wp-prototype, .cf-wine-profile .wp-result-actions, .cf-wine-profile .wp-email-section, .cf-wine-profile .wp-clear-row, .cf-wine-profile .wp-skip { display: none!important; }
  .cf-wine-profile .wp-shell { width: 100%; padding: 0; margin: 0; box-shadow: none; border: 0; background: white; }
  .cf-wine-profile h2 { margin-top: 0; }
  .cf-wine-profile p, .cf-wine-profile li { font-size: 10pt; }
  .cf-wine-profile .wp-section { margin-top: 14pt; padding-top: 14pt; }
  .cf-wine-profile .wp-recommendations li, .cf-wine-profile .wp-preferences div, .cf-wine-profile .wp-exercise { break-inside: avoid; }
  .cf-wine-profile h3, .cf-wine-profile h4 { break-after: avoid; }
  .cf-wine-profile:not([data-phase='result']) #wp-app { display: none; }
}

.cf-wine-profile { display:block; box-sizing:border-box; width:100%; --color-surface:var(--color-background,#fcfbf8); --color-text:var(--color-foreground,#0a0a0c); --color-muted:var(--color-foreground-muted,#5a6470); --wp-border:color-mix(in srgb,var(--color-foreground,#0a0a0c) 18%,transparent); --color-accent:var(--color-primary-button-background,#4a002e); --color-accent-soft:color-mix(in srgb,var(--color-primary-button-background,#4a002e) 8%,transparent); color:var(--color-text); font:400 16px/1.5 var(--font-body--family,Arial,Helvetica,sans-serif); }
.cf-wine-profile .wp-shell { width:min(100%,50rem); margin-inline:auto; background:var(--color-surface); }
.cf-wine-profile h1,.cf-wine-profile h2,.cf-wine-profile h3,.cf-wine-profile h4,.cf-wine-profile .wp-kicker { font-family:var(--font-heading--family,Georgia,serif); color:var(--color-text); font-weight:var(--font-heading--weight,400); }
.cf-wine-profile button { font-family:inherit; cursor:pointer; color:var(--color-text); }
.cf-wine-profile .wp-primary { border:1px solid var(--color-accent); background:var(--color-accent); color:var(--color-primary-button-text,#fcfbf8); text-decoration:none; }
.cf-wine-profile .wp-primary:hover { background:var(--color-primary-button-hover-background,#360022); color:var(--color-primary-button-hover-text,#fcfbf8); }
.cf-wine-profile a { color:var(--color-accent); text-decoration:underline; text-underline-offset:.2em; }
.cf-wine-profile .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
@media print { body:has(cf-wine-profile-email[data-phase='result']) * { visibility:hidden; } body:has(cf-wine-profile-email[data-phase='result']) cf-wine-profile-email,body:has(cf-wine-profile-email[data-phase='result']) cf-wine-profile-email * { visibility:visible; } body:has(cf-wine-profile-email[data-phase='result']) cf-wine-profile-email { position:absolute; inset:0; width:100%; padding:0; } .cf-wine-profile:not([data-phase='result']) .wp-shell { display:none; } .cf-wine-profile .wp-note,.cf-wine-profile .wp-email-panel { display:none; } }
.cf-wine-profile [hidden]{display:none!important}.wp-email-panel{margin-top:2rem}.wp-email-panel button:disabled{opacity:.65;cursor:wait}.wp-email-panel input[type="checkbox"]{width:auto;margin-right:.5rem}.wp-email-panel label{display:block;margin-block:.7rem}{% endstylesheet %}
<cf-wine-profile-email class="cf-wine-profile" data-privacy-url="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' | escape }}" data-journal-url="{{ section.settings.journal_url | default: '/pages/vintages' | escape }}" data-email-enabled="false" data-login-url="{{ routes.storefront_login_url | escape }}">
  <div class="wp-shell">
    <div class="wp-masthead"><p class="wp-eyebrow">A little curiosity. A personal discovery.</p><span class="wp-edition">The Wine Profile · No. 01</span></div>
    <h1 class="wp-page-title">Discover Your Wine Profile.</h1>
    <div data-wp-app><p>Preparing your Wine Profile…</p></div>
    <noscript><p>This quiz needs JavaScript. Your details have not been collected.</p></noscript>
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-wp-status></p>
  </div>
  {% if customer %}<div data-wp-native-signup hidden>{% assign wine_profile_signup_id = 'WineProfileSignup-' | append: section.id %}{% form 'customer', id: wine_profile_signup_id, return_to: request.path %}<label for="WineProfileEmail-{{ section.id }}">Your account email</label><input id="WineProfileEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ customer.email | escape }}" readonly required><input type="hidden" name="contact[tags]" value="newsletter"><label><input type="checkbox" name="contact[accepts_marketing]" value="true" required data-wp-signup-consent>I would like to receive email marketing from Chateau Follent. I can unsubscribe at any time.</label><p class="wp-note">Signup is optional. If confirmation is required, confirm through your inbox before requesting your profile email.</p><button class="wp-primary" type="submit">Sign up for email marketing</button>{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% if form.posted_successfully? %}<p>Signup submitted. Confirm through your inbox if required, then check your subscription.</p>{% endif %}{% endform %}</div>{% endif %}
</cf-wine-profile-email>
<script>(() => {
const QUIZ_VERSION = '1.0.0';
const CONSENT_VERSION = '2026-10-20';
const options = (items) => items.map(([id, label]) => ({ id, label }));
const QUESTIONS = [
  { id: 'wine_interests', title: 'Which types of wine do you enjoy or want to explore?', kind: 'multi', exclusive: 'exploring', options: options([
    ['red', 'Red wine'], ['white', 'White wine'], ['rose', 'Rosé'], ['sparkling', 'Sparkling wine'], ['mead', 'Mead or honey-based wine'], ['experimental', 'Experimental or small-batch wines'], ['exploring', "I'm still exploring"],
  ]) },
  { id: 'flavour_preferences', title: 'Which flavour descriptions appeal to you?', kind: 'multi', max: 3, exclusive: 'unsure', options: options([
    ['crisp', 'Fresh and crisp'], ['delicate', 'Light and delicate'], ['aromatic', 'Fruity and aromatic'], ['rich', 'Rich and full-bodied'], ['savoury', 'Dry and savoury'], ['smooth', 'Sweet and smooth'], ['unsure', "I'm not sure yet"],
  ]) },
  { id: 'body_preference', title: 'What style of wine do you generally prefer?', kind: 'single', options: options([
    ['light', 'Light-bodied'], ['medium', 'Medium-bodied'], ['full', 'Full-bodied'], ['varied', 'I enjoy different styles'], ['unsure', "I'm not sure"],
  ]) },
  { id: 'sweetness_preference', title: 'How sweet do you usually prefer your wine?', kind: 'single', options: options([
    ['dry', 'Dry'], ['off_dry', 'Slightly sweet / off-dry'], ['sweet', 'Sweet'], ['varied', 'It depends on the wine'], ['unsure', "I'm not sure"],
  ]) },
  { id: 'wine_occasions', title: 'When do you typically enjoy or purchase wine?', kind: 'multi', exclusive: 'non_drinker', options: options([
    ['meals', 'With meals'], ['sharing', 'Sharing with friends or family'], ['celebrations', 'Special celebrations'], ['gifts', 'Giving as gifts'], ['cellaring', 'Collecting or cellaring'], ['tasting', 'Wine tasting and discovery'], ['non_drinker', "I don't currently drink or purchase wine"],
  ]) },
  { id: 'discovery_interest', title: 'How interested are you in exploring unfamiliar wines?', kind: 'single', options: options([
    ['familiar', 'I usually stick with familiar favourites'], ['occasional', 'I occasionally try something different'], ['adventurous', 'I enjoy discovering new varieties and styles'], ['learning', "I'm still learning what I enjoy"],
  ]) },
  { id: 'education_interest', title: 'What would you most like to learn about wine?', kind: 'single', options: options([
    ['grapes', 'Understanding grape varieties'], ['winemaking', 'How wine is made'], ['pairing', 'Food and wine pairing'], ['tasting', 'How to taste and describe wine'], ['regions', 'Wine regions and growing conditions'], ['journey', 'Following the journey of a small winery'],
  ]) },
];
const DISCOVERY_SOURCES = options([
  ['instagram_james', 'Instagram — James Follent'], ['instagram_chateau', 'Instagram — Chateau Follent'], ['youtube', 'YouTube'], ['facebook', 'Facebook'], ['search', 'Google or another search engine'], ['friends_family', 'Friends or family'], ['wine_event', 'Wine club or wine event'], ['website', 'Another website'], ['other', 'Other'], ['unknown', "I can't remember"],
]);
const CONSENT = {
  marketing: "I'd like to receive Chateau Follent vintage journals, news and occasional updates about future releases and membership.",
  birthday: "I'd like Chateau Follent to remember my birthday and send me a birthday message.",
};

// Style descriptions are starting points, not guarantees about every producer or bottle.
const style = (id, name, categories, flavours, body, sweetness, sensory, unfamiliar = false) => ({ id, name, categories, flavours, body, sweetness, sensory, unfamiliar });
const STYLES = [
  style('pinot_noir', 'Light-bodied Pinot Noir', ['red'], ['delicate', 'aromatic', 'savoury'], 'light', 'dry', 'A red-cherry aroma and a gentle, drying finish.'),
  style('shiraz', 'Full-bodied Shiraz', ['red'], ['rich', 'savoury', 'aromatic'], 'full', 'dry', 'Dark plum fruit with a hint of black pepper.'),
  style('cabernet', 'Cabernet Sauvignon', ['red'], ['rich', 'savoury'], 'full', 'dry', 'Blackcurrant aromas and a firm, drying texture.'),
  style('malbec', 'Full-bodied Malbec', ['red'], ['rich', 'aromatic'], 'full', 'dry', 'Dark-berry aromas with a generous, rounded texture.'),
  style('grenache', 'Medium-bodied Grenache', ['red'], ['aromatic', 'delicate'], 'medium', 'dry', 'Red-berry aromas with a rounded texture.'),
